# ── CyberRakshak — environment template ─────────────────────────────
# Copy to `.env` (root), `backend/.env`, and `frontend/.env.local` as needed.

# --- Security ---
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_MIN_LENGTH=12

# --- Database (backend) ---
DATABASE_URL=postgresql+psycopg2://sentinel:sentinel_dev_password@localhost:5432/sentinel
# For a quick local run without Docker use:
# DATABASE_URL=sqlite:///./sentinel.db

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Rate limiting ---
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_INGEST_PER_MINUTE=6000
RATE_LIMIT_GENERAL_PER_MINUTE=120

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Seed (first run) ---
SEED_DEMO_DATA=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@cyberrakshak.demo
SEED_ADMIN_PASSWORD=Sentinel@123

# --- Windows Agent ---
AGENT_SERVER_URL=http://localhost:8000
AGENT_API_TOKEN=
AGENT_UNIT_CODE=UNIT-01
AGENT_HOSTNAME=CRPF-PC-001
AGENT_POLL_INTERVAL=5
AGENT_BATCH_SIZE=100
AGENT_QUEUE_PATH=./agent_queue
AGENT_TLS_VERIFY=true
