# CyberRakshak backend environment
# REQUIRED in production — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate-a-strong-random-value-see-comment-above
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=postgresql+psycopg2://sentinel:sentinel_dev_password@localhost:5432/sentinel
# Local quick-start (no docker):
# DATABASE_URL=sqlite:///./sentinel.db

API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set to true only when running behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_INGEST_PER_MINUTE=6000
RATE_LIMIT_GENERAL_PER_MINUTE=120

SEED_DEMO_DATA=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@cyberrakshak.in
SEED_ADMIN_PASSWORD=Sentinel@123
