# CyberRakshak backend environment
# REQUIRED in production — generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=generate-a-strong-random-value-see-comment-above
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Local quick-start (SQLite, no server needed) — matches the app default:
DATABASE_URL=sqlite:///./sentinel.db
# Production / shared DB (Postgres):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/sentinel

API_HOST=0.0.0.0
API_PORT=8000
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set to true only when running behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_INGEST_PER_MINUTE=6000
RATE_LIMIT_GENERAL_PER_MINUTE=120

SEED_DEMO_DATA=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@cyberrakshak.in
SEED_ADMIN_PASSWORD=Sentinel@123

# Criminal Intelligence graph store: "relational" (default) or "neo4j".
GRAPH_BACKEND=relational
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=

# Template query bar — optional grounded narrative layer. OFF by default.
# When enabled, /api/query adds a strictly-grounded LLM summary over the
# template results (OpenAI-compatible chat completions). Never fabricates.
QUERY_LLM_ENABLED=false
QUERY_LLM_BASE_URL=https://api.openai.com/v1
QUERY_LLM_API_KEY=
QUERY_LLM_MODEL=gpt-4o-mini
